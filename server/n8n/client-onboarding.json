{
  "name": "dev.hyd — Client Onboarding Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "client-onboarding",
        "options": {}
      },
      "name": "Webhook - Client Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "client-onboarding-webhook"
    },
    {
      "parameters": {
        "content": "### 👤 Client Onboarding Workflow\n1. Triggers when new client account is registered\n2. Sends Welcome Email with portal credentials link\n3. Dispatches WhatsApp onboarding notification",
        "height": 220,
        "width": 360
      },
      "name": "Sticky Note - Documentation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 80]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst client = body.data || body;\n\nreturn {\n  json: {\n    clientId: client.id || 'CLI-0000',\n    name: client.name || 'Valued Client',\n    email: client.email || 'N/A',\n    phone: client.phone || 'N/A',\n    portalUrl: (process.env.CLIENT_URL || 'http://localhost:5173') + '/login',\n    createdAt: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })\n  }\n};"
      },
      "name": "Parse Client Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "fromEmail": "dev.hyd.official@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "=🎉 Welcome to dev.hyd Client Portal, {{ $json.name }}!",
        "html": "=<div style=\"font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; padding: 24px; border-radius: 12px;\">\n  <h2 style=\"color: #38bdf8;\">Welcome, {{ $json.name }}!</h2>\n  <p>Your dev.hyd Client Portal account has been activated.</p>\n  <p>You can track your project milestones, pay invoices, and communicate directly with developers at:</p>\n  <p><a href=\"{{ $json.portalUrl }}\" style=\"color: #38bdf8; font-weight: bold;\">{{ $json.portalUrl }}</a></p>\n</div>"
      },
      "name": "Send Client Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"👤 *Welcome to dev.hyd Client Portal* 👤\\n\\nHi {{ $json.name }}, your client portal is active! Log in at {{ $json.portalUrl }} to track project progress.\"\n  }\n}"
      },
      "name": "WhatsApp Onboarding Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [720, 360]
    },
    {
      "parameters": {
        "options": { "responseCode": 200 },
        "responseBody": "={ \"status\": \"success\", \"event\": \"CLIENT_CREATED\" }"
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [940, 300]
    }
  ],
  "connections": {
    "Webhook - Client Created": {
      "main": [[{ "node": "Parse Client Details", "type": "main", "index": 0 }]]
    },
    "Parse Client Details": {
      "main": [[
        { "node": "Send Client Welcome Email", "type": "main", "index": 0 },
        { "node": "WhatsApp Onboarding Alert", "type": "main", "index": 0 },
        { "node": "Respond to Webhook", "type": "main", "index": 0 }
      ]]
    }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "versionId": "1.0.0",
  "tags": ["dev.hyd", "client-onboarding", "whatsapp", "email"]
}
