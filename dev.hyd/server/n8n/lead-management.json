{
  "name": "dev.hyd — Lead Management Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-management",
        "options": {}
      },
      "name": "Webhook - Lead Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "lead-intake-webhook"
    },
    {
      "parameters": {
        "content": "### 📌 Lead Management Workflow\n1. Validates incoming website enquiry\n2. Formats lead context & assigns unique ID\n3. Triggers WhatsApp Cloud API alert\n4. Sends instant confirmation email to client\n5. Appends lead into Google Sheets CRM",
        "height": 220,
        "width": 360
      },
      "name": "Sticky Note - Documentation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 80]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst lead = body.data || body;\n\nreturn {\n  json: {\n    leadId: lead.id || 'LEAD-' + Math.random().toString(36).substring(2, 9).toUpperCase(),\n    name: lead.name || 'Anonymous Visitor',\n    email: lead.email || 'N/A',\n    phone: lead.phone || 'N/A',\n    business: lead.business || 'Individual / Startup',\n    service: lead.service || 'Website Development',\n    budget: lead.budget || 'Custom Quote',\n    message: lead.message || 'No additional notes',\n    createdAt: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })\n  }\n};"
      },
      "name": "Format & Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚀 *dev.hyd New Enquiry* 🚀\\n\\nHi {{ $json.name }}, thank you for submitting your enquiry for *{{ $json.service }}*! Our team will reach out to you within 24 hours to set up your free 2-day demo.\"\n  }\n}"
      },
      "name": "WhatsApp Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [720, 180],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "fromEmail": "dev.hyd.official@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "=🎉 Thank you for reaching out to dev.hyd, {{ $json.name }}!",
        "html": "=<div style=\"font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; padding: 24px; border-radius: 12px;\">\n  <h2 style=\"color: #38bdf8; margin-top:0;\">Hi {{ $json.name }},</h2>\n  <p>We received your enquiry for <strong>{{ $json.service }}</strong>!</p>\n  <p>Our team will reach out to you within 24 hours on <strong>{{ $json.phone }}</strong> to discuss your free 2-day demo.</p>\n  <p style=\"color: #94a3b8; font-size: 13px;\">dev.hyd Web & Automation Platform</p>\n</div>"
      },
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [720, 320]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "={{ $env.GOOGLE_SHEETS_ID }}",
        "range": "Leads!A:H",
        "options": {}
      },
      "name": "Append to CRM Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [720, 460]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "responseBody": "={\n  \"status\": \"success\",\n  \"message\": \"Lead successfully processed and logged\",\n  \"leadId\": \"{{ $json.leadId }}\"\n}"
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [940, 300]
    }
  ],
  "connections": {
    "Webhook - Lead Intake": {
      "main": [[{ "node": "Format & Validate Lead", "type": "main", "index": 0 }]]
    },
    "Format & Validate Lead": {
      "main": [[
        { "node": "WhatsApp Notification", "type": "main", "index": 0 },
        { "node": "Send Confirmation Email", "type": "main", "index": 0 },
        { "node": "Append to CRM Sheet", "type": "main", "index": 0 },
        { "node": "Respond to Webhook", "type": "main", "index": 0 }
      ]]
    }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "versionId": "1.0.0",
  "tags": ["dev.hyd", "lead-management", "whatsapp", "email"]
}
