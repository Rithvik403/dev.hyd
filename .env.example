# ==========================================
# dev.hyd Next.js Production Environment Config
# ==========================================

# Database Connection (Supabase PostgreSQL / Neon / Local PostgreSQL)
# Required in production. If omitted or unreachable, dev.hyd automatically
# switches to its embedded resilient local fallback data store.
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Authentication Secrets (Generate secure random 64-char strings)
JWT_SECRET="dev-hyd-access-token-secret-key-prod-2026-super-secure"
JWT_REFRESH_SECRET="dev-hyd-refresh-token-secret-key-prod-2026-super-secure"

# Master Admin Credentials (For initial auto-seeding)
ADMIN_EMAIL="admin@devhyd.com"
ADMIN_PASSWORD="admin123"

# Node Environment ('production' or 'development')
NODE_ENV="production"

# Razorpay Payments Gateway (Optional - for milestone payment collections)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Nodemailer Email Service (Optional - for automated email notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="dev.hyd.official@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="dev.hyd Official <dev.hyd.official@gmail.com>"

# n8n / Webhook Automation Dispatcher (Optional)
N8N_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/dev-hyd-events"
